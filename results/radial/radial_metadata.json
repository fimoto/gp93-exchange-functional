{
  "input_file": "inputs/radial.json",
  "input_settings": {
    "schema_version": 1,
    "purpose": "Basis-free radial exchange-only Kohn-Sham spectra of H (spin-polarized) and He (closed shell).",
    "note": "Every ground-state spin channel of H and He is one orbital, so alpha = 0, G(alpha) = 1 and v_tau = 0; the meta-GGA reduces to a GGA on these densities.",
    "radial_grid": {
      "variable": "x = ln r",
      "r_min_bohr": 1e-06,
      "r_max_bohr": 200.0,
      "points": 8000
    },
    "grid_check": {
      "r_max_bohr": 400.0,
      "points": 12000
    },
    "shift_invert_targets_ha": [
      [
        -1.2,
        4
      ],
      [
        -0.15,
        10
      ],
      [
        -0.02,
        14
      ]
    ],
    "ground_state_shift_ha": -1.5,
    "angular_momenta": [
      0,
      1,
      2
    ],
    "levels_per_l": 14,
    "bound_threshold_ha": 0.0,
    "reported_threshold_ha": -1e-05,
    "scf": {
      "max_cycle": 400,
      "potential_residual_tolerance": 1e-06
    },
    "systems": [
      {
        "name": "H",
        "nuclear_charge": 1,
        "electrons": 1,
        "spin": "polarized"
      },
      {
        "name": "He",
        "nuclear_charge": 2,
        "electrons": 2,
        "spin": "closed"
      }
    ],
    "functionals": [
      {
        "name": "PBE_X",
        "kind": "pbe",
        "mixing": {
          "H": [
            0.3,
            0.1
          ],
          "He": [
            0.3,
            0.1
          ]
        }
      },
      {
        "name": "GP93_X",
        "kind": "gp93",
        "mixing": {
          "H": [
            0.3,
            0.1
          ],
          "He": [
            0.3,
            0.1
          ]
        }
      },
      {
        "name": "GP93R_X",
        "kind": "gp93r",
        "mixing": {
          "H": [
            0.1,
            0.03
          ],
          "He": [
            0.3,
            0.1
          ]
        }
      }
    ],
    "coulomb_test": {
      "max_n": 6,
      "angular_momenta": [
        0,
        1,
        2
      ]
    },
    "exact_reference_file": "data/he_exact_ks_levels.csv"
  },
  "selected_parameters": {
    "s0": 0.16,
    "p": 8
  },
  "gp93r": {
    "s1": 0.5,
    "D": 800.0,
    "window": [
      1e-06,
      0.0001
    ]
  },
  "level_labels": "hydrogenic-like ordering label: the first virtual s level is 2s, the first p level 2p, the first d level 3d",
  "counts": "n_bound_levels and n_bound_orbitals_one_spin count levels below reported_threshold_ha; n_marginal_levels counts levels between reported_threshold_ha and zero"
}
