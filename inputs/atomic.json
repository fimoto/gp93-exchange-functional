  "systems": [
    {"name": "H", "atom": "H 0 0 0", "basis": "aug-cc-pv5z", "ecp": null, "charge": 0, "spin_2S": 1, "method": "UKS"},
    {"name": "He", "atom": "He 0 0 0", "basis": "aug-cc-pv5z", "ecp": null, "charge": 0, "spin_2S": 0, "method": "RKS"},
    {"name": "Li", "atom": "Li 0 0 0", "basis": "crenbl", "ecp": "crenbl", "charge": 0, "spin_2S": 1, "method": "UKS"},
    {"name": "Na", "atom": "Na 0 0 0", "basis": "sbkjc", "ecp": "sbkjc", "charge": 0, "spin_2S": 1, "method": "UKS"},
    {"name": "K", "atom": "K 0 0 0", "basis": "sbkjc", "ecp": "sbkjc", "charge": 0, "spin_2S": 1, "method": "UKS"}
