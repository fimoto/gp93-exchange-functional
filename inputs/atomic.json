{
  "schema_version": 1,
  "purpose": "Matched exchange-only atomic calculations and diffuse negative-energy virtual-state analysis.",
  "experimental_data_file": "data/experimental_ip.csv",
  "coordinate_unit": "Angstrom",
  "grid_level": 6,
  "final_conv_tol": 1e-9,
